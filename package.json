{
  "name": "hados",
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "HadOS — a Web OS in the browser: isolated processes, mediated syscalls, user-consented capabilities, packaged apps and an async IndexedDB/OPFS file system.",
  "main": "main.ts",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:guest && npm run copy:litert && npm run copy:genai && npm run copy:ort && npm run build:ai-worker",
    "build:guest": "vite build --config vite.guest.config.ts",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint js/ main.ts",
    "lint:fix": "eslint js/ main.ts --fix",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:guest && npm run build:games && npm run copy:litert && npm run copy:genai && npm run copy:ort && npm run build:ai-worker && vite build",
    "build:games": "npx tailwindcss -i tailwind-games.css -o public/css/tailwind-games.css --content \"./public/games/**/*.html\" --minify",
    "generate:app": "tsx scripts/create-app.ts",
    "preview": "vite preview",
    "copy:litert": "tsx scripts/copy-litert-wasm.ts",
    "copy:genai": "tsx scripts/copy-genai-wasm.ts",
    "copy:ort": "tsx scripts/copy-ort-wasm.ts",
    "build:ai-worker": "vite build --config vite.ai-worker.config.ts",
    "generate:demo-video": "npx tsx scripts/generate-demo-video.ts"
  },
  "keywords": [
    "windows95",
    "retro",
    "desktop",
    "vite",
    "prototyping",
    "sandbox",
    "3d-physics"
  ],
  "author": "HaDeS (A.K.A. DeViLDoNia)",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@huggingface/transformers": "^4.2.0",
    "@litertjs/core": "^2.5.2",
    "@mediapipe/tasks-genai": "^0.10.29",
    "@types/three": "^0.183.1",
    "three": "^0.183.2"
  }
}
